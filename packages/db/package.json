    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@kgb/tsconfig": "workspace:*",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "vitest": "^4.1.11"
  }
