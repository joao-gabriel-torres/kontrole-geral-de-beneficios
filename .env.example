# Banco de desenvolvimento e de testes (Postgres local do Homebrew).
# O usuário é o seu login do macOS (`whoami`); o Prisma exige o usuário explícito na URL.
DATABASE_URL="postgresql://SEU_USUARIO@localhost:5432/kgb_dev"
DATABASE_URL_TEST="postgresql://SEU_USUARIO@localhost:5432/kgb_test"

# Better Auth — gere o segredo com: openssl rand -base64 32
BETTER_AUTH_SECRET="troque-por-um-segredo-com-32-caracteres-ou-mais"
# Endereço público da API. Em produção, o https dela (ex.: https://api.seu-dominio.com.br).
BETTER_AUTH_URL="http://localhost:3000"

# Origens liberadas no CORS e no Better Auth (gestor, prestador web, Capacitor iOS e Android),
# sem barra nem caminho no fim. Em produção, as URLs dos dois projetos do Cloudflare Pages no
# lugar das do localhost, por exemplo:
# CORS_ORIGINS="https://gestor.seu-dominio.com.br,https://prestador.seu-dominio.com.br,capacitor://localhost,https://localhost"
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,capacitor://localhost,https://localhost"
PORT=3000

# Pasta das fotos enviadas pelo app (dev). Em produção, trocar por S3/R2.
ARQUIVOS_DIR="var/uploads"

# Convite por e-mail do prestador. Sem SMTP_URL (desenvolvimento), cada e-mail é gravado em
# var/emails/ e o link aparece no log da API. Em produção (NODE_ENV=production) a API não sobe
# sem SMTP_URL, EMAIL_REMETENTE e URL_APP_PRESTADOR. Por exemplo:
# SMTP_URL="smtps://usuario:senha@smtp.seu-provedor.com:465"
# Senha ou chave com caracteres especiais (/, #, +…) — comum em SendGrid/SES — entra codificada
# com encodeURIComponent (no Node: node -p 'encodeURIComponent("SUA_CHAVE")').
# EMAIL_REMETENTE="Russo Assistência <nao-responda@seu-dominio.com.br>"
# URL_APP_PRESTADOR="https://app.seu-dominio.com.br"
SMTP_URL=""
EMAIL_REMETENTE=""
# Endereço do app do prestador no link do convite (/convite?token=…). Vazio no dev: http://localhost:5174
URL_APP_PRESTADOR=""

# Para onde o Vite dos apps encaminha /api em dev (útil para rodar duas APIs em portas diferentes)
API_PROXY_ALVO="http://localhost:3000"

# Fronts: vazio usa o proxy do Vite (/api -> :3000). O build do Cloudflare Pages e o nativo do
# prestador precisam da URL absoluta da API (no Pages, entra nas variáveis do projeto).
VITE_API_URL=""
