# Banco de desenvolvimento e de testes (Postgres local do Homebrew).
# O usuário é o seu login do macOS (`whoami`); o Prisma exige o usuário explícito na URL.
DATABASE_URL="postgresql://SEU_USUARIO@localhost:5432/kgb_dev"
DATABASE_URL_TEST="postgresql://SEU_USUARIO@localhost:5432/kgb_test"

# Better Auth — gere o segredo com: openssl rand -base64 32
BETTER_AUTH_SECRET="troque-por-um-segredo-com-32-caracteres-ou-mais"
BETTER_AUTH_URL="http://localhost:3000"

# Origens liberadas no CORS e no Better Auth (gestor, prestador web, Capacitor iOS e Android)
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,capacitor://localhost,https://localhost"
PORT=3000

# Pasta das fotos enviadas pelo app (dev). Em produção, trocar por S3/R2.
ARQUIVOS_DIR="var/uploads"

# Convite por e-mail do prestador. Sem SMTP_URL (desenvolvimento), cada e-mail é gravado em
# var/emails/ e o link aparece no log da API. Em produção, por exemplo:
# SMTP_URL="smtps://usuario:senha@smtp.seu-provedor.com:465" (EMAIL_REMETENTE passa a ser obrigatório)
SMTP_URL=""
EMAIL_REMETENTE="Russo Assistência <nao-responda@exemplo.com.br>"
# Endereço do app do prestador no link do convite (/convite?token=…)
URL_APP_PRESTADOR="http://localhost:5174"

# Para onde o Vite dos apps encaminha /api em dev (útil para rodar duas APIs em portas diferentes)
API_PROXY_ALVO="http://localhost:3000"

# Fronts: vazio usa o proxy do Vite (/api -> :3000). Build nativo do prestador precisa da URL absoluta.
VITE_API_URL=""
